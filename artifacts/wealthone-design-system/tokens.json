{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "ezyRetire tokens extracted from the ezyRetire application. Light mode is source-faithful; dark mode is source-faithful where defined and completed from the source palette.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fcfaf8" },
      "foreground": { "$value": "#131c39" },
      "border": { "$value": "#ebe7e0" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#131c39" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#131c39" },
      "primary": { "$value": "#12286d", "$description": "Deep indigo for primary actions and active navigation." },
      "primaryForeground": { "$value": "#fcfaf8" },
      "secondary": { "$value": "#f8ab30", "$description": "Saffron highlight for supporting emphasis." },
      "secondaryForeground": { "$value": "#131c39" },
      "muted": { "$value": "#efece7" },
      "mutedForeground": { "$value": "#626a84" },
      "accent": { "$value": "#efece7" },
      "accentForeground": { "$value": "#131c39" },
      "destructive": { "$value": "#ef4343" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#ebe7e0" },
      "ring": { "$value": "#12286d" },
      "chart1": { "$value": "#12286d" },
      "chart2": { "$value": "#f8ab30" },
      "chart3": { "$value": "#6684e5" },
      "chart4": { "$value": "#626a84" },
      "chart5": { "$value": "#ef4343" },
      "sidebar": { "$value": "#fcfaf8" },
      "sidebarForeground": { "$value": "#131c39" },
      "sidebarBorder": { "$value": "#ebe7e0" },
      "sidebarPrimary": { "$value": "#12286d" },
      "sidebarPrimaryForeground": { "$value": "#fcfaf8" },
      "sidebarAccent": { "$value": "#efece7" },
      "sidebarAccentForeground": { "$value": "#131c39" },
      "sidebarRing": { "$value": "#12286d" }
    },
    "dark": {
      "background": { "$value": "#0d1326" },
      "foreground": { "$value": "#fcfaf8" },
      "border": { "$value": "#242b42" },
      "card": { "$value": "#12182b" },
      "cardForeground": { "$value": "#fcfaf8" },
      "popover": { "$value": "#12182b" },
      "popoverForeground": { "$value": "#fcfaf8" },
      "primary": { "$value": "#6684e5" },
      "primaryForeground": { "$value": "#0d1326" },
      "secondary": { "$value": "#f8ab30" },
      "secondaryForeground": { "$value": "#0d1326" },
      "muted": { "$value": "#242b42" },
      "mutedForeground": { "$value": "#a3aac2" },
      "accent": { "$value": "#242b42" },
      "accentForeground": { "$value": "#fcfaf8" },
      "destructive": { "$value": "#d92626" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#242b42" },
      "ring": { "$value": "#6684e5" },
      "chart1": { "$value": "#6684e5" },
      "chart2": { "$value": "#f8ab30" },
      "chart3": { "$value": "#a3aac2" },
      "chart4": { "$value": "#ef4343" },
      "chart5": { "$value": "#fcfaf8" },
      "sidebar": { "$value": "#12182b" },
      "sidebarForeground": { "$value": "#fcfaf8" },
      "sidebarBorder": { "$value": "#242b42" },
      "sidebarPrimary": { "$value": "#6684e5" },
      "sidebarPrimaryForeground": { "$value": "#0d1326" },
      "sidebarAccent": { "$value": "#242b42" },
      "sidebarAccentForeground": { "$value": "#fcfaf8" },
      "sidebarRing": { "$value": "#6684e5" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Plus Jakarta Sans", "sans-serif"], "$description": "Primary UI and body face." },
      "serif": { "$value": ["Fraunces", "serif"], "$description": "Editorial headings and financial milestones." },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.75rem" }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
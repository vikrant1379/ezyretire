{
  "name": "@workspace/wealthone-expenses",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "brand:build": "node scripts/build-brand-assets.mjs",
    "brand:check": "node scripts/build-brand-assets.mjs --check",
    "brand:verify": "node scripts/check-brand-regression.mjs",
    "fonts:build": "node scripts/build-font-version.mjs",
    "fonts:verify": "node scripts/build-font-version.mjs",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "prebuild": "pnpm run brand:check",
    "build": "vite build --config vite.config.ts",
    "check:bundle-budget": "vite build --config vite.config.ts",
    "check:mobile-performance": "playwright test --config playwright.performance.config.ts",
    "check:favicon-visual": "playwright test e2e/favicon-visual.spec.ts --config playwright.config.ts --project desktop-chromium",
    "check:admin-hmr": "playwright test e2e/admin-hmr.spec.ts --config playwright.config.ts --project desktop-chromium",
    "check:design-system-visual": "playwright test e2e/design-system-visual.spec.ts --config playwright.config.ts",
    "check:dark-theme-visual": "playwright test e2e/dark-theme-visual.spec.ts --config playwright.config.ts --project desktop-chromium --project mobile-touch-chromium",
    "check:design-system-cross-browser": "node scripts/check-webkit-runtime.mjs && playwright test e2e/design-system-visual.spec.ts --config playwright.config.ts --project cross-browser-firefox --project cross-browser-webkit",
    "check:pwa": "playwright install firefox webkit && playwright test --config playwright.pwa.config.ts",
    "check:pwa:safari-release": "node scripts/check-safari-private-storage.mjs",
    "check:pwa:webkit-release": "node scripts/check-webkit-runtime.mjs && playwright test --config playwright.pwa.config.ts --project webkit-private-storage-warning",
    "check:published-favicons": "node scripts/check-published-favicons.mjs",
    "check:published-fonts": "node scripts/check-published-fonts.mjs",
    "check:published-auth-analytics": "node scripts/check-published-auth-analytics.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "pretypecheck": "tsc --build ../../lib/api-client-react/tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run brand:check && pnpm run brand:verify && pnpm run fonts:verify -- --verify ezyretire-v3 && node scripts/check-financial-save-architecture.mjs && node --test src/lib/*.test.ts scripts/*.test.mjs && tsx --test src/hooks/*.test.ts src/components/*.test.tsx",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@workspace/api-client-react": "workspace:*",
    "@workspace/replit-auth-web": "workspace:*",
    "@workspace/wealthone-design-system": "workspace:*",
    "date-fns": "^3.6.0",
    "lucide-react": "catalog:",
    "pdfjs-dist": "^6.3.289",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.55.0",
    "recharts": "^2.15.2",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "wouter": "^3.3.5",
    "xlsx": "^0.18.5",
    "zod": "catalog:"
  }
}

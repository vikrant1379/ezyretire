{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./database-url": {
      "types": "./database-url.d.mts",
      "default": "./database-url.mjs"
    }
  },
  "scripts": {
    "check:release-records": "node ./scripts/check-release-records.mjs",
    "check:production-schema": "node ./scripts/check-production-schema.mjs",
    "test": "node --test ./scripts/*.test.mjs",
    "test:database-selection": "node --test ./scripts/database-selection.test.mjs",
    "test:production-schema": "node --test ./scripts/check-production-schema.test.mjs",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
